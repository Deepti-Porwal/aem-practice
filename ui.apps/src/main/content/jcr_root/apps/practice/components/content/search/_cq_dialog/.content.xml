<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
        xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
        xmlns:cq="http://www.day.com/jcr/cq/1.0"
        xmlns:jcr="http://www.jcp.org/jcr/1.0"
        xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
        jcr:primaryType="nt:unstructured"
        jcr:title="Search"
        sling:resourceType="cq/gui/components/authoring/dialog">
    <content
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tabs
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/tabs">

                <items jcr:primaryType="nt:unstructured">

                    <!-- ===============================
                         SEARCH SETTINGS TAB
                         =============================== -->
                    <searchTab
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Search Settings"
                            sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <!-- Search Root -->
                            <searchRoot
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Search Root"
                                    name="./searchRoot"
                                    rootPath="/content"/>

                            <!-- Results Limit -->
                            <limit
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Results Limit"
                                    name="./limit"
                                    value="10"/>

                            <!-- Debounce -->
                            <debounce
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Debounce Time (ms)"
                                    name="./debounce"
                                    value="300"/>

                            <!-- Search In -->
                            <searchIn
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkboxgroup"
                                    fieldLabel="Search In"
                                    name="./searchIn">

                                <items jcr:primaryType="nt:unstructured">

                                    <title
                                            jcr:primaryType="nt:unstructured"
                                            text="Title"
                                            value="title"/>

                                    <content
                                            jcr:primaryType="nt:unstructured"
                                            text="Content"
                                            value="content"/>

                                    <tags
                                            jcr:primaryType="nt:unstructured"
                                            text="Tags"
                                            value="tags"/>

                                </items>

                            </searchIn>

                        </items>

                    </searchTab>

                    <!-- ===============================
                         DISPLAY SETTINGS
                         =============================== -->
                    <displayTab
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Display Settings"
                            sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <!-- Highlight -->
                            <highlight
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    text="Enable Highlight"
                                    name="./highlight"
                                    value="{Boolean}true"/>

                            <!-- Pagination -->
                            <pagination
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    text="Enable Pagination"
                                    name="./pagination"
                                    value="{Boolean}true"/>

                            <!-- Show Description -->
                            <showDescription
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    text="Show Description"
                                    name="./showDescription"
                                    value="{Boolean}true"/>

                            <!-- Sort By -->
                            <sortBy
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Sort By"
                                    name="./sortBy">

                                <items jcr:primaryType="nt:unstructured">

                                    <relevance
                                            jcr:primaryType="nt:unstructured"
                                            text="Relevance"
                                            value="relevance"/>

                                    <modified
                                            jcr:primaryType="nt:unstructured"
                                            text="Last Modified"
                                            value="modified"/>

                                </items>

                            </sortBy>

                        </items>

                    </displayTab>

                    <!-- ===============================
                         FILTER SETTINGS
                         =============================== -->
                    <filterTab
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Filters"
                            sling:resourceType="granite/ui/components/coral/foundation/container">

                        <items jcr:primaryType="nt:unstructured">

                            <!-- Template Filter -->
                            <template
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Template Filter"
                                    name="./template"/>

                            <!-- Tag Filter -->
                            <tags
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                    fieldLabel="Tag Filter"
                                    name="./tags"/>

                        </items>

                    </filterTab>

                </items>

            </tabs>

        </items>

    </content>
</jcr:root>
